{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rocket Rust",
  "mainBinaryName": "rocket-rust",
  "version": "0.1.0",
  "identifier": "io.t3w.rocketrust",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rocket Rust",
        "width": 640,
        "height": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQkJFMkE4RDg4NzZEOEQKUldTTmJZZllxT0s3aStnMnlqb005MDdFSE45aFk1WmlTTEwybldudXZEM3FGWW8xcGpQNkFHVEUK",
      "endpoints": [
        "https://github.com/fincatto/rocket-rust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
